# =============================================================================
# Remote Agents — example environment (copy to .env, chmod 600, never commit)
# =============================================================================

# --- Control server (typically Linux VPS, bound to localhost behind nginx) ---
NODE_ENV=production
PORT=3847
HOST=127.0.0.1
APP_USERNAME=admin
# Prefer scrypt hash (generate: node scripts/gen-secrets.js)
APP_PASSWORD_HASH=
# Plain password fallback only for local dev; do not use in production
# APP_PASSWORD=
SESSION_SECRET=
WORKER_TOKEN=
PUBLIC_ORIGIN=https://agents.example.com
SESSION_DAYS=30
# One trusted nginx hop; use 0 for direct local development
TRUST_PROXY=1
# SESSION_DIR=/var/lib/remote-agents/sessions

# --- Worker (outbound connection to control server) ---
SERVER_URL=https://agents.example.com
# Optional Host header override if SERVER_URL hostname differs from TLS cert
SERVER_HOST=
# WORKER_TOKEN is defined above; use the same value on both machines
# WORKER_TOKEN=
WORKER_ID=worker-primary
# Optional macOS LaunchAgent label; existing installation labels are preserved
# WORKER_LAUNCH_AGENT_LABEL=com.remote-agents.worker
# Optional service executable search path (resolved installer PATH by default)
# WORKER_PATH=
CURSOR_API_KEY=
# cli | bridge | sdk | machine | degraded
CURSOR_RUNTIME=cli
CURSOR_BIN=cursor
# Optional IDE workspace mapping for bridge mode
# CURSOR_CHAT_WORKSPACE=
CODEX_BIN=
CLAUDE_BIN=claude
DEFAULT_CWD=
WORKSPACES_ROOT=
WORKER_DATA_DIR=
KEEP_AWAKE=1
# Cursor CLI: disabled = full filesystem (--sandbox disabled); enabled = sandbox on
WORKER_SANDBOX=disabled
WORKER_FORCE=1

# Optional fleet override (version-1 JSON; see examples/fleet.defaults.json)
# AGENT_FLEET_FILE=/path/to/fleet.json
