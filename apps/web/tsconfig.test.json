{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-test",
    "rootDir": "src",
    "declaration": false,
    "esModuleInterop": true,
    "paths": {
      "@remote-agents/shared": [
        "../../packages/shared/dist/index.d.ts"
      ]
