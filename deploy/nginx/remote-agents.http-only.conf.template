# HTTP-only vhost for initial ACME / bootstrap. Render with envsubst.

upstream remote_agents_app {
    server 127.0.0.1:${REMOTE_AGENTS_PORT};
    keepalive 8;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${REMOTE_AGENTS_DOMAIN};

    access_log /var/log/nginx/remote_agents_http.access.log;
    error_log  /var/log/nginx/remote_agents_http.error.log;

    location /.well-known/acme-challenge/ {
        root ${REMOTE_AGENTS_ACME_ROOT};
        default_type text/plain;
    }

    location /ws/ {
        proxy_pass http://remote_agents_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://remote_agents_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
    }
}
