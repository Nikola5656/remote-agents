# Copy to .env on the server before install-server.sh
# All paths and hostnames are parameterized — no hardcoded private IPs.

REMOTE_AGENTS_DOMAIN=agents.example.com
REMOTE_AGENTS_INSTALL_DIR=/opt/remote-agents
REMOTE_AGENTS_STATE_DIR=/var/lib/remote-agents
REMOTE_AGENTS_SERVICE_USER=www-data
REMOTE_AGENTS_PORT=3847
REMOTE_AGENTS_LE_EMAIL=admin@example.com
REMOTE_AGENTS_ACME_ROOT=/var/www/remote-acme
REMOTE_AGENTS_NGINX_DIR=/etc/nginx/conf.d

# Application secrets (generate with: node scripts/gen-secrets.js)
NODE_ENV=production
TRUST_PROXY=1
SESSION_DIR=/var/lib/remote-agents/sessions
PORT=3847
HOST=127.0.0.1
APP_USERNAME=admin
APP_PASSWORD_HASH=
SESSION_SECRET=
WORKER_TOKEN=
PUBLIC_ORIGIN=https://agents.example.com
SESSION_DAYS=30
